    def test_llama4_default_full_output_uses_one_qualified_norm_contract():
        transformers = pytest.importorskip("transformers")
        config = transformers.Llama4TextConfig().to_dict()
        diagram = unfold(config)
        before = deepcopy(diagram.to_ir())
        expanded = diagram.to_json()
        html = diagram.to_html(standalone=True)
        events = diagram.render_events()
    
        schedule = [layer.attention.qk_norm for layer in diagram.ir.layers[:12]]
        assert schedule == [True, True, True, False] * 3
        for group in expanded["layer_groups"]:
            index = group["layers"]["indices"][0]
            spec = diagram.ir.layers[index].attention
            canonical = {op.id for op in attention_region(
                before["layers"][index]["attention"],
                diagram.ir.hidden_size).ops}
            emitted = {
                node["id"] for node in
                group["attention"]["operation_graph"]["nodes"]}
            if spec.qk_norm:
                assert {"q_norm", "k_norm"} <= canonical
                assert {"q_norm", "k_norm"} <= emitted
                assert {"q_reshape", "k_reshape"}.isdisjoint(canonical)
                assert {"q_reshape", "k_reshape"}.isdisjoint(emitted)
            else:
                assert {"q_norm", "k_norm", "q_reshape", "k_reshape"}.isdisjoint(
                    canonical | emitted)
    
        assert html.count('data-id="q_norm"') == 1
        assert html.count('data-id="k_norm"') == 1
        assert len(_emitted_cards(html, "q_norm")) == 1
        assert len(_emitted_cards(html, "k_norm")) == 1
        assert 'data-id="q_reshape"' not in html
        assert 'data-id="k_reshape"' not in html
        assert not _emitted_cards(html, "q_reshape")
        assert not _emitted_cards(html, "k_reshape")
        assert before == diagram.to_ir()
        assert llm_cross_surface_findings(before, expanded, events, html) == []
