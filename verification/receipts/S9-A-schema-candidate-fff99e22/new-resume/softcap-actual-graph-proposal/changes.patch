+def _softcap_is_drawn(attn, region, graph) -> bool:
+    """One decoder softcap is projected only by its actual canonical operation.
+
+    A positive native fact may outlive an opaque attention diagram. Neither
+    its value nor a familiar node ID proves that the renderer drew tanh.
+    """
+    if attn.get("node_prefix") or attn.get("logit_softcap") is None:
+        return False
+    operation = region.by_id().get("attn_softcap")
+    node = graph.by_id().get("attn_softcap")
+    return (operation is not None and operation.kind == "activation"
+            and operation.fn == "tanh" and node is not None
+            and node.kind == "activation" and node.resolved)
+
+
+def _attention_graph_facts(ir, attn, region, graph) -> frozenset:
+    """Keep the same finite softcap drawing test on every attention drill."""
+    projected = attention_facts(ir)
+    if not _softcap_is_drawn(attn, region, graph):
+        projected -= {"decoder.attention.logit_softcap"}
+    return projected
 
 
