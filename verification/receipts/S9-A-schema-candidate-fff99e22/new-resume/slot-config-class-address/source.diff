+@dataclass(frozen=True)
+class ConfigClassAddress:
+    """An already-resolved registry address, never a default/value proof.
+
+    The current child is bound through its current parent, independently of
+    the original source/context address. No old checkpoint or overlay travels
+    on this capability. Preparation still examines every current value.
+    """
+
+    context: Any = field(repr=False, compare=False)
+    parent_document: Any = field(repr=False, compare=False)
+    document: Any = field(repr=False, compare=False)
+    component: str
+    document_path: tuple[str, ...]
+    registry_key: str
+    architecture: str | None
+    component_files: tuple[str, ...]
+    supporting_files: tuple[str, ...]
+
+    def validate(self, raw) -> None:
+        if raw is not self.document or not isinstance(raw, dict):
+            raise ValueError("config-class address describes another child document")
+        if not self.document_path or self.document_path[-1] != self.component:
+            raise ValueError("config-class address has a foreign slot path")
+        current = self.parent_document
+        for part in self.document_path:
+            if not isinstance(current, dict) or part not in current:
+                raise ValueError("config-class address has no current parent binding")
+            current = current[part]
+        if current is not raw:
+            raise ValueError("config-class address has a foreign parent binding")
+        bundle = getattr(self.context, "source_bundle", None)
+        keys = getattr(self.context, "config_class_keys_by_path", {})
+        if not self.registry_key or keys.get(self.document_path) != self.registry_key:
+            raise ValueError("config-class address differs from the original document address")
+        if (getattr(bundle, "component_model_types", {}) or {}).get(self.component) != self.registry_key:
+            raise ValueError("config-class address differs from the resolved source component")
+        if (getattr(bundle, "component_architectures", {}) or {}).get(self.component) != self.architecture:
+            raise ValueError("config-class address has a foreign model-class address")
+        if not self.component_files or tuple((getattr(bundle, "component_files", {}) or {}).get(self.component, ())) != self.component_files:
+            raise ValueError("config-class address has foreign modeling sources")
+        if tuple((getattr(bundle, "supporting_files", {}) or {}).get(self.component, ())) != self.supporting_files:
+            raise ValueError("config-class address has foreign supporting sources")
+
+    def cache_identity(self, raw) -> tuple:
+        self.validate(raw)
+        from hashlib import sha256
+        from pathlib import Path
+        sources = tuple((path, sha256(Path(path).read_bytes()).hexdigest())
+                        for path in dict.fromkeys((*self.component_files, *self.supporting_files)))
+        return ("AutoConfig.for_model", self.registry_key, self.component,
+                self.document_path, self.architecture, sources)
 
 
