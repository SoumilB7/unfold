--- frozen26/tests/test_structural_writes.py
+++ candidate/tests/test_structural_writes.py
@@ -12,6 +12,8 @@
 from __future__ import annotations
 
 from collections import Counter
+
+import pytest
 
 from model_unfolder.evidence.structural_writes import (
     STRUCTURAL_SURFACE,
@@ -195,3 +197,49 @@
         '    return ModelIR(extras={**other})\n')
     assert any(w.sink == 'extras' and w.target == '<dynamic>'
                and w.symbol == 'project' for w in scan_structural_writes(root=pkg))
+
+
+@pytest.mark.parametrize("symbol,methods", [
+    ("_note_fact", ("record", "record_typed")),
+    ("_note_ffn_mechanism_fact", ("record_typed",)),
+    ("parse", ("record_typed", "record_typed", "record_typed")),
+])
+def test_s9_typed_writer_registration_is_exact_and_counted(tmp_path, symbol, methods):
+    """A finite pin cannot hide an extra call, renamed author or moved module."""
+    from model_unfolder.evidence.structural_writes import (
+        StructuralWriteKey, new_structural_writers,
+        scan_structural_write_multiset, stale_structural_writers,
+    )
+
+    pkg = _pkg(tmp_path)
+    parser = pkg / "adapters" / "transformer" / "parser.py"
+    parser.parent.mkdir(parents=True)
+    module = "model_unfolder/adapters/transformer/parser.py"
+    key = StructuralWriteKey(module, symbol, "ledger", "<dynamic>")
+
+    def source(writer, calls):
+        return f"def {writer}(ledger, owner, name, fact):\n" + "".join(
+            "    ledger.record(owner, name, fact)\n" if method == "record"
+            else "    ledger.record_typed(fact)\n" for method in calls)
+
+    parser.write_text(source(symbol, methods))
+    assert scan_structural_write_multiset(pkg)[key] == len(methods)
+    assert new_structural_writers(pkg) == []
+    assert key not in stale_structural_writers(pkg)
+
+    parser.write_text(source(symbol, (*methods, "record_typed")))
+    assert key in new_structural_writers(pkg)
+
+    renamed = symbol + "_unregistered"
+    parser.write_text(source(renamed, methods))
+    assert StructuralWriteKey(module, renamed, "ledger", "<dynamic>") in new_structural_writers(pkg)
+    assert key in stale_structural_writers(pkg)
+
+    parser.unlink()
+    moved = parser.with_name("unregistered_parser.py")
+    moved.write_text(source(symbol, methods))
+    assert StructuralWriteKey(
+        "model_unfolder/adapters/transformer/unregistered_parser.py",
+        symbol, "ledger", "<dynamic>",
+    ) in new_structural_writers(pkg)
+    assert key in stale_structural_writers(pkg)
