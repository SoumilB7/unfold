+    def _module_access_syntax(self):
+        parents = {child: parent for parent in ast.walk(self.tree)
+                   for child in ast.iter_child_nodes(parent)}
+        for node in ast.walk(self.tree):
+            if not isinstance(node, ast.Name):
+                continue
+            receiver = node
+            parent = parents.get(receiver)
+            while isinstance(parent, (ast.Attribute, ast.Subscript)) and parent.value is receiver:
+                receiver = parent
+                parent = parents.get(receiver)
+            context = getattr(receiver, "ctx", node.ctx)
+            self.module_name_accesses.append(ModuleNameAccess(
+                node.id, self._expr(receiver),
+                "store" if isinstance(context, ast.Store) else
+                "del" if isinstance(context, ast.Del) else "load",
+                self._expr(parent) if isinstance(parent, (ast.Call, ast.Compare)) else None,
+                type(parent).__name__ if parent is not None else "Module",
+                self._span(node)))
+
+    def _module_statement_syntax(self, body, guard, scope=None):
+        for node in body:
+            targets = ()
+            value = None
+            if isinstance(node, ast.Assign):
+                targets, value = tuple(self._expr(item) for item in node.targets), self._expr(node.value)
+            elif isinstance(node, ast.AnnAssign):
+                targets = (self._expr(node.target),)
+                value = self._expr(node.value) if node.value is not None else None
+            elif isinstance(node, ast.AugAssign):
+                targets, value = (self._expr(node.target),), self._expr(node.value)
+            elif isinstance(node, ast.Delete):
