+class _DefaultPremiseUnavailable(ValueError):
+    """The optional exact default-channel accounting evidence is unavailable."""
+
+
+@dataclass(frozen=True)
+class ClassDefaultPremise:
+    """Exact address/value of the prepared class-default channel, not an occurrence.
+
+    This accounts for a supplied default operand. It proves neither a modeling
+    operation nor that a literal class declaration survived constructor logic.
+    Those stronger claims remain owned by their source readers.
+    """
+
+    document: Any = field(repr=False, compare=False)
+    source_obj: Any = field(repr=False, compare=False)
+    path: tuple[str, ...]
+    spellings: tuple[str, ...]
+    component: str
+    document_path: tuple
+    value_hash: str
+    document_fingerprint: str = field(repr=False)
+    document_token: str = field(repr=False)
+    supplying_channels_hash: str = field(repr=False)
+
+    def validate_address(self) -> None:
+        """Exact omitted address/scope, independent of which default channel supplied it."""
+        document = self.document
+        if current_prepared_document.get() is not document \
+                or current_document.get()[0] != self.document_path \
+                or not verify_prepared_document_token(
+                    document, self.document_fingerprint, self.document_token):
+            raise _DefaultPremiseUnavailable("default premise belongs to another or changed prepared document")
+        if document.failure is not None or not self.path or not self.spellings \
+                or self.path[-1] != self.spellings[0]:
+            raise _DefaultPremiseUnavailable("default premise requires successful preparation and an exact source address")
+        if checkpoint_fingerprint({"document": document.document,
+                                   "class_overlay": document.class_overlay,
+                                   "provenance": document.provenance}) != self.supplying_channels_hash:
+            raise _DefaultPremiseUnavailable("default premise supplying channels changed")
+        for mapping in (document.document, document.checkpoint):
+            container = mapping
+            for segment in self.path[:-1]:
+                container = _member(container, segment)
+                if container is MISSING or container is None or isinstance(
+                        container, (str, bytes, int, float, bool, list, tuple)):
+                    raise _DefaultPremiseUnavailable("default premise has no exact addressed parent")
+            if mapping is document.document and container is not self.source_obj:
+                raise _DefaultPremiseUnavailable("default premise was resolved from a foreign source container")
+            if any(_member(container, spelling) is not MISSING for spelling in self.spellings):
+                raise _DefaultPremiseUnavailable("default premise cannot replace a present checkpoint spelling, including null")
+    def validate(self) -> None:
+        from .receipts import value_status_hash
+        self.validate_address()
+        document = self.document
+        dotted = ".".join(self.path)
+        if dotted not in document.class_overlay or value_status_hash(
+                document.class_overlay[dotted], "class_default") != self.value_hash:
+            raise _DefaultPremiseUnavailable("default premise value differs from the prepared class-default channel")
+
+    def validate_value(self, value) -> None:
+        from .receipts import value_status_hash
+        self.validate()
+        if value_status_hash(value, "class_default") != self.value_hash:
+            raise _DefaultPremiseUnavailable("default resolution value differs from its retained premise")
+
+
+def _validate_default_premise_type(premise) -> None:
+    if type(premise) is ClassDefaultPremise:
+        return
+    # The second channel is source-owned. No callback, protocol, subclass or
+    # caller-created default dictionary can extend this closed authority set.
+    from .config_registration import RegisteredConstructorDefaultPremise
+    if type(premise) is not RegisteredConstructorDefaultPremise:
+        raise TypeError("default event requires an exact supported typed default premise")
+
+
+def _class_default_premise(cfg, path, spellings, value, component):
+    """Retain a default address only when the active preparation establishes it."""
+    document = current_prepared_document.get()
+    if document is None or document.failure is not None:
+        return None
+    from .receipts import value_status_hash
+    dotted = ".".join(path)
+    if dotted not in document.class_overlay or value_status_hash(
+            document.class_overlay[dotted], "class_default") != value_status_hash(value, "class_default"):
+        return None
+    fingerprint, token = _current_document_seal()
+    if not fingerprint or not token:
+        return None
+    premise = ClassDefaultPremise(
+        document, cfg, path, tuple(spellings), component, current_document.get()[0],
+        value_status_hash(value, "class_default"), fingerprint, token,
+        checkpoint_fingerprint({"document": document.document,
+                                "class_overlay": document.class_overlay,
+                                "provenance": document.provenance}))
+    try:
+        premise.validate()
+    except _DefaultPremiseUnavailable:
+        # A bare/foreign default dictionary remains unqualified metadata. The
+        # resolver's value channel is unchanged; no stronger claim is invented.
+        return None
+    return premise
+
