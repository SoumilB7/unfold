tests/test_attention_mechanism.py::test_fused_grouped_claim_requires_width_split_and_all_shape_links[\nclass Mixer:\n    def __init__(self, config):\n        self.width = config.hidden\n        self.query_groups = config.query_groups\n        self.unit = self.width // self.query_groups\n        section = config.attention\n        self.shared_groups = section.shared_groups\n        self.packed = nn.Linear(config.hidden, 3 * self.width)\n    def forward(self, x):\n        shape = (*x.shape[:-1], -1, self.unit)\n        packed = self.packed(x)\n        query, key, value = packed.split([\n            self.width,\n            self.shared_groups * self.unit,\n            self.shared_groups * self.unit,\n        ], dim=-1)\n        query = query.view(shape)\n        key = key.view(shape)\n        value = value.view(shape)\n        score = torch.matmul(query, key.transpose(-1, -2))\n        return torch.matmul(F.softmax(score, dim=-1), value)\n]
tests/test_attention_mechanism.py::test_fused_grouped_claim_requires_width_split_and_all_shape_links[\nclass Mixer:\n    def __init__(self, config):\n        self.width = config.hidden\n        self.query_groups = config.query_groups\n        self.unit = self.width // self.query_groups\n        section = config.attention\n        self.shared_groups = section.shared_groups\n        self.packed = nn.Linear(config.hidden, self.width + 2 * self.shared_groups * self.unit)\n    def forward(self, x):\n        shape = (*x.shape[:-1], -1, self.unit)\n        packed = self.packed(x)\n        query, key, value = packed.split([\n            self.width,\n            self.shared_groups * self.unit,\n            self.query_groups * self.unit,\n        ], dim=-1)\n        query = query.view(shape)\n        key = key.view(shape)\n        value = value.view(shape)\n        score = torch.matmul(query, key.transpose(-1, -2))\n        return torch.matmul(F.softmax(score, dim=-1), value)\n]
tests/test_attention_mechanism.py::test_fused_grouped_claim_requires_width_split_and_all_shape_links[\nclass Mixer:\n    def __init__(self, config):\n        self.width = config.hidden\n        self.query_groups = config.query_groups\n        self.unit = self.width // self.query_groups\n        section = config.attention\n        self.shared_groups = section.shared_groups\n        self.packed = nn.Linear(config.hidden, self.width + 2 * self.shared_groups * self.unit)\n    def forward(self, x):\n        shape = (*x.shape[:-1], -1, self.unit)\n        packed = self.packed(x)\n        query, key, value = packed.split([\n            self.width,\n            self.shared_groups * self.unit,\n            self.shared_groups * self.unit,\n        ], dim=-1)\n        query = query.view(shape)\n        key = key.view(shape)\n        value = value\n        score = torch.matmul(query, key.transpose(-1, -2))\n        return torch.matmul(F.softmax(score, dim=-1), value)\n]
