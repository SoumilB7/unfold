tests/test_attention_mechanism.py::test_equal_projection_width_without_complete_shape_chain_is_powerless[\nclass Mixer:\n    def __init__(self, config):\n        self.width = config.hidden\n        self.groups = config.query_groups\n        self.unit = self.width // self.groups\n        self.a = nn.Linear(self.width, self.width)\n        self.b = nn.Linear(self.width, self.width)\n        self.c = nn.Linear(self.width, self.width)\n    def forward(self, x):\n        query = self.a(x)\n        key = self.b(x)\n        value = self.c(x)\n        query = query.view((*x.shape[:-1], -1))\n        key = key.view((*x.shape[:-1], -1))\n        value = value.view((*x.shape[:-1], -1))\n        score = torch.matmul(query, key.transpose(-1, -2))\n        return torch.matmul(F.softmax(score, dim=-1), value)\n]
tests/test_attention_mechanism.py::test_equal_projection_width_without_complete_shape_chain_is_powerless[\nclass Mixer:\n    def __init__(self, config):\n        self.width = config.hidden\n        self.groups = config.query_groups\n        self.unit = self.width // self.groups\n        self.a = nn.Linear(self.width, self.width)\n        self.b = nn.Linear(self.width, self.width)\n        self.c = nn.Linear(self.width, self.width)\n    def forward(self, x):\n        query = self.a(x)\n        key = self.b(x)\n        value = self.c(x)\n        query = query.view((*x.shape[:-1], -1, self.unit))\n        key = key.view((*x.shape[:-1], -1, self.unit))\n        value = value\n        score = torch.matmul(query, key.transpose(-1, -2))\n        return torch.matmul(F.softmax(score, dim=-1), value)\n]
